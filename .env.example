# Copy to .env and adjust for your environment.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://oan:oan@localhost:5432/oan_reports

# --- API ---
APP_ENV=development
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SEED_ON_STARTUP=true

# --- Upstream chart services (from Postman collections) ---
# Leave blank until each service is available; reports will show an empty/connected state.
UPSTREAM_A2C_BASE_URL=
UPSTREAM_GRIEVANCE_BASE_URL=
UPSTREAM_FARMER_BASE_URL=
UPSTREAM_LIVESTOCK_BASE_URL=
UPSTREAM_CROP_BASE_URL=
# Optional multi-chart gateway: GET {base}/api/charts?charts=a,b
UPSTREAM_GATEWAY_BASE_URL=

UPSTREAM_TIMEOUT_SECONDS=20

# --- Frontend (frontend/.env) ---
# VITE_API_BASE_URL=
