  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Expected row fields per chart ID (the dashboard services' API references).",
          "const FIELDS = {\"farmerKpis\":[\"total_farmers\",\"female_farmers\",\"male_farmers\",\"total_land_size\",\"avg_farm_size\",\"farmers_with_owned_land\",\"household_heads\",\"farmers_with_id\",\"farmers_without_id\"],\"farmersByRegion\":[\"region\",\"region_code\",\"farmers\"],\"farmersByZone\":[\"zone\",\"zone_code\",\"farmers\"],\"farmersByGender\":[\"gender\",\"farmers\"],\"farmersByType\":[\"farming_type\",\"farmers\"],\"farmersByAgeAndGender\":[\"age_group\",\"gender\",\"farmers\"],\"farmersByEducation\":[\"education\",\"farmers\"],\"farmersByRecordState\":[\"record_state\",\"farmers\"],\"landTenureSplit\":[\"ownership_type\",\"parcels\",\"area\"],\"registryTrendByMonth\":[\"period\",\"farmers\",\"total_area\",\"owned_area\"],\"livestockKpis\":[\"holdings\",\"keepers\",\"female_keepers\",\"woredas_reporting\",\"animals\",\"species_tracked\",\"breeds_tracked\"],\"livestockBySpecies\":[\"species\",\"species_code\",\"animals\",\"keepers\"],\"livestockByBreed\":[\"breed\",\"breed_code\",\"species\",\"animals\"],\"livestockKeepersByRegion\":[\"region\",\"region_code\",\"farmers\",\"animals\"],\"livestockKeepersByZone\":[\"zone\",\"zone_code\",\"farmers\",\"animals\"],\"livestockTopWoredas\":[\"woreda\",\"woreda_code\",\"farmers\",\"animals\"],\"herdHealthSplit\":[\"health_status\",\"animals\"],\"livestockVaccinationStatus\":[\"vaccination_status\",\"animals\"],\"livestockBySex\":[\"sex\",\"animals\"],\"livestockTrendByMonth\":[\"period\",\"farmers\",\"holdings\",\"animals\"],\"livestockByState\":[\"state\",\"holdings\"],\"livestockByRecordState\":[\"record_state\",\"holdings\"],\"cropKpis\":[\"total_area\",\"owned_area\",\"farmers\",\"registrations\",\"crop_types\",\"woredas_reporting\",\"avg_plot_size\"],\"cropAreaByCrop\":[\"crop\",\"crop_code\",\"area\",\"farmers\"],\"cropAreaByRegion\":[\"region\",\"region_code\",\"farmers\",\"farmer_count\"],\"cropAreaByZone\":[\"zone\",\"zone_code\",\"farmers\",\"farmer_count\"],\"cropTopWoredas\":[\"woreda\",\"woreda_code\",\"area\",\"farmers\"],\"cropLandTenureSplit\":[\"ownership_type\",\"ownership_type_code\",\"parcels\",\"area\"],\"cropBySeason\":[\"season\",\"season_code\",\"area\",\"farmers\"],\"cropTrendByMonth\":[\"period\",\"farmers\",\"total_area\",\"owned_area\"],\"cropByStatus\":[\"status\",\"registrations\"],\"cropByLifecycleStage\":[\"lifecycle_stage\",\"registrations\"],\"cropByRecordState\":[\"record_state\",\"registrations\"]};",
          "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
          "pm.test(\"JSON response\", () => pm.response.to.be.json);",
          "const path = pm.request.url.getPath();",
          "const body = pm.response.json();",
          "if (path === \"/api/health\") {",
          "  pm.test(\"status ok\", () => pm.expect(body.status).to.eql(\"ok\"));",
          "} else if (path === \"/api/config\") {",
          "  pm.test(\"registries offered\", () => pm.expect(body.dashboards).to.include(\"registries\"));",
          "  pm.test(\"registry views reported\", () => pm.expect(body.registryViews).to.have.all.keys(\"crop\", \"livestock\"));",
          "} else if (path === \"/api/filter-options\") {",
          "  pm.test(\"regions are P-codes\", () => body.regions.forEach(r => pm.expect(r.code).to.match(/^ET[0-9]{2}$/)));",
          "} else if (path === \"/api/maps/units\") {",
          "  pm.test(\"woredas with their parents\", () => {",
          "    pm.expect(body).to.be.an(\"array\").that.is.not.empty;",
          "    pm.expect(body[0]).to.have.all.keys(\"woreda\", \"zone\", \"region\");",
          "  });",
          "} else if (path === \"/api/charts\") {",
          "  const ids = (pm.request.url.query.get(\"charts\") || \"\").split(\",\").filter(Boolean);",
          "  pm.test(\"Envelope has data and summary\", () => {",
          "    pm.expect(body).to.have.property(\"data\").that.is.an(\"object\");",
          "    pm.expect(body).to.have.property(\"summary\");",
          "  });",
          "  pm.test(\"No chart failed\", () => pm.expect(body.summary.failed, JSON.stringify(body.errors)).to.eql(0));",
          "  ids.forEach(chart => {",
          "    const result = body.data[chart];",
          "    const keys = FIELDS[chart];",
          "    pm.test(`${chart}: rows array`, () => {",
          "      pm.expect(result, `${chart} missing`).to.be.an(\"object\");",
          "      pm.expect(result.success, result && result.error).to.be.true;",
          "      pm.expect(result.data).to.be.an(\"array\");",
          "    });",
          "    if (!keys || !result || !Array.isArray(result.data) || !result.data.length) return;",
          "    pm.test(`${chart}: fields ${keys.join(\", \")}`, () => pm.expect(result.data[0]).to.include.all.keys(...keys));",
          "    const codeKey = [\"region_code\", \"zone_code\", \"woreda_code\"].find(k => k in result.data[0]);",
          "    if (!codeKey) return;",
          "    // Catches a level shift (e.g. zones returned as regions): ET + 2 digits per level.",
          "    // Units outside the usual chain (special woredas) are only logged; a majority fails.",
          "    const width = { region_code: 4, zone_code: 6, woreda_code: 8 }[codeKey];",
          "    const codes = result.data.map(r => r[codeKey]).filter(c => c !== \"Unknown\");",
          "    const odd = codes.filter(c => !(typeof c === \"string\" && c.length === width && /^ET[0-9]+$/.test(c)));",
          "    if (odd.length) console.warn(`${chart}: ${codeKey} outside the usual level:`, odd);",
          "    pm.test(`${chart}: ${codeKey} is at its level`, () => {",
          "      pm.expect(odd.length, `wrong-level codes: ${odd.slice(0, 5)}`).to.be.below(Math.max(1, codes.length / 2));",
          "    });",
          "  });",
          "}"
        ]
      }
    }
